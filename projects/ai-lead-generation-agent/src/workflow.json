      "parameters": {
        "jsCode": "// Simulamos el texto que enviaríamos por Telegram\nconst text = \"clinicas dentales; 2; Rosario, Argentina\";\n\ntry {\n  const [rubro, cantidad, ciudad] = text.split(';').map(s => s.trim());\n\n  if (!rubro || !cantidad || !ciudad) {\n    throw new Error(\"Formato incorrecto. Usa: rubro; cantidad; ciudad\");\n  }\n\n  const query = encodeURIComponent(`${rubro} en ${ciudad}`);\n  const mapsUrl = `https://www.google.com/maps/search/${query}`;\n\n  return {\n    rubro,\n    limite: parseInt(cantidad, 10),\n    ciudad,\n    mapsUrl\n  };\n} catch (error) {\n  return { error: error.message };\n}"
      },
